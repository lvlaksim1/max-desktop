<Window x:Class="MaxDesktop.App.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Вход в MAX" Width="440" Height="550" MinWidth="390" MinHeight="475"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Closing="Window_Closing"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
 <Grid Margin="24,21,24,18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="Подключение аккаунта" FontSize="21" FontWeight="SemiBold"/>
   <TextBlock Text="Вход через WebSocket или TCP MAX" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1">
   <TextBlock Text="Номер телефона" Margin="0,0,0,7"/>
   <TextBox x:Name="PhoneBox" Height="37" VerticalContentAlignment="Center"
            ToolTip="Введите номер в формате +79991234567"/>
   <TextBlock Text="Способ подключения" Margin="0,10,0,7"/>
   <ComboBox x:Name="TransportPicker" Height="34" SelectedIndex="0"
             ToolTip="WebSocket использует WEB-протокол. TCP — прежний мобильный транспорт. QR не используется.">
    <ComboBoxItem Content="Автоматически (сначала Microsoft Edge)"/>
    <ComboBoxItem Content="WebSocket через браузер Edge"/>
    <ComboBoxItem Content="WebSocket через .NET"/>
    <ComboBoxItem Content="TCP (мобильный протокол)"/>
   </ComboBox>
   <Button x:Name="SendCodeButton" Content="Получить код" HorizontalAlignment="Stretch"
           Margin="0,11,0,0" Click="SendCode_Click"/>
   <Button x:Name="TestConnectionButton" Content="Проверить соединение (без номера)" HorizontalAlignment="Stretch"
           Margin="0,8,0,0" Click="TestConnection_Click"
           ToolTip="Проверка выбранного транспорта и SESSION_INIT без номера или кода"/>
  </StackPanel>
  <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
   <StackPanel>
   <StackPanel x:Name="CodeSection" Visibility="Collapsed">
    <TextBlock x:Name="CodeHint" Text="Код подтверждения" Margin="0,0,0,7"/>
    <PasswordBox x:Name="CodeBox" Height="37" Padding="9,8"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource LineBrush}"/>
    <Button x:Name="VerifyCodeButton" Content="Подтвердить код"
            Margin="0,11,0,0" HorizontalAlignment="Stretch" Click="VerifyCode_Click"/>
   </StackPanel>
   <StackPanel x:Name="PasswordSection" Visibility="Collapsed">
    <TextBlock Text="Дополнительный пароль MAX" Margin="0,0,0,7"/>
    <TextBlock x:Name="PasswordHint" TextWrapping="Wrap"
               Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7"/>
    <PasswordBox x:Name="PasswordBox" Height="37" Padding="9,8"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource LineBrush}"/>
    <Button x:Name="VerifyPasswordButton" Content="Проверить пароль"
            Margin="0,11,0,0" HorizontalAlignment="Stretch" Click="VerifyPassword_Click"/>
   </StackPanel>
   <TextBox x:Name="StatusText" IsReadOnly="True" BorderThickness="0"
       Foreground="{DynamicResource MutedBrush}" Background="Transparent"
       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
       Height="112" Margin="0,15,0,0" Padding="0" FontSize="12"
       Text="Сервер может запросить SMS, проверку звонком или дополнительный пароль. Возможности входа проверяются по мере исследования."/>
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
    <Button Content="Копировать" Width="105" Margin="0,0,8,0"
            Click="CopyDiagnostics_Click" ToolTip="Копировать текущий текст диагностики"/>
    <Button x:Name="CancelOperationButton" Content="Отменить" Width="105" Margin="0,0,8,0"
            Visibility="Collapsed" Click="CancelOperation_Click"/>
    <Button Content="Закрыть" Width="105" Margin="0" Click="Close_Click"/>
  </StackPanel>
 </Grid>
</Window>
