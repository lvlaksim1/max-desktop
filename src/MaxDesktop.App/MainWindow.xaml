<Window x:Class="MaxDesktop.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MAX Desktop" Height="780" Width="1240" MinHeight="520" MinWidth="820"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" Loaded="Window_Loaded">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
   <DockPanel Margin="18,9">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="35" Height="35" Background="{DynamicResource AccentBrush}" CornerRadius="10" Margin="0,0,10,0">
      <TextBlock Text="M" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="MAX Desktop" FontWeight="SemiBold" FontSize="16"/>
      <TextBlock Text="Настольный клиент" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
     </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
     <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,20,0" VerticalAlignment="Center"/>
     <Button x:Name="CheckUpdateButton" Content="Обновить" Click="CheckUpdate_Click"/>
     <Button Content="Настройки" Click="Settings_Click" Margin="0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Background="{DynamicResource PanelBrush}">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="AccountColumn" Width="215" MinWidth="150"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition x:Name="ChatColumn" Width="320" MinWidth="220"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="240"/>
   </Grid.ColumnDefinitions>
   <Grid Grid.Column="0" Background="{DynamicResource PanelBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="16,19,14,15">
     <TextBlock Text="АККАУНТЫ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
     <Border Padding="10" CornerRadius="8" Background="{DynamicResource InputBrush}">
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="○" FontSize="23" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="AccountStateText" Text="Не подключён" FontWeight="SemiBold" FontSize="12"/>
        <TextBlock x:Name="AccountPhoneText" Text="Нет активного сеанса" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Button x:Name="AddAccountButton" Content="+ Добавить аккаунт" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="AddAccount_Click"/>
     <Button x:Name="RemoveAccountButton" Content="Выйти из аккаунта" Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="RemoveAccount_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="16,12,14,17">
     <TextBlock Text="Разработка интерфейса" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="12"/>
     <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"
      Text="Сетевое подключение пока не включено. Сообщения и аккаунты не имитируются."/>
    </StackPanel>
   </Grid>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}" ResizeBehavior="PreviousAndNext"/>
   <Grid Grid.Column="2" Background="{DynamicResource PanelBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="17,17,17,13">
     <TextBlock Text="Чаты" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,13"/>
     <TextBox x:Name="ChatSearch" TextChanged="ChatSearch_TextChanged" ToolTip="Поиск по загруженным чатам"/>
    </StackPanel>
    <ListBox Grid.Row="1" x:Name="ChatList" DisplayMemberPath="Title" SelectionChanged="ChatList_SelectionChanged"/>
   </Grid>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}" ResizeBehavior="PreviousAndNext"/>
   <Grid Grid.Column="4" Background="{DynamicResource WindowBrush}">
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource PanelBrush}">
     <StackPanel Margin="20,11">
      <TextBlock x:Name="ConversationTitle" Text="Переписка не выбрана" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock x:Name="ConversationHint" Text="Выберите чат после подключения аккаунта" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
     </StackPanel>
    </Border>
    <Grid Grid.Row="1">
     <ListBox x:Name="MessageList" Visibility="Collapsed" Margin="15"/>
     <StackPanel x:Name="EmptyConversation" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350">
      <Border Width="72" Height="72" Background="{DynamicResource InputBrush}" CornerRadius="36" HorizontalAlignment="Center" Margin="0,0,0,15">
       <TextBlock Text="✉" FontSize="35" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock Text="MAX Desktop" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock Text="Нативный интерфейс подготовлен. Для реальных чатов требуется проверенный протокол авторизации и обмена сообщениями."
       Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource PanelBrush}">
     <Grid Margin="15,15">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="ComposeText" IsEnabled="False" VerticalContentAlignment="Center" ToolTip="Отправка будет доступна после реализации протокола"/>
      <Button Grid.Column="1" Content="Отправить" IsEnabled="False" Margin="10,0,0,0"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
   <DockPanel Margin="10,3">
    <ProgressBar x:Name="UpdateProgressBar" DockPanel.Dock="Right" Width="150" Minimum="0" Maximum="100" Height="10" Visibility="Collapsed"/>
    <TextBlock x:Name="StatusLabel" Text="Готово. Сетевые функции отключены до подтверждения протокола." FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
